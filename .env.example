# Port to listen on. Render (and most hosts) set this for you - leave it unset there.
PORT=3000

# Extra browser origins allowed to open a lobby socket, comma separated.
#
# The two Vite dev origins are already built in (see src/server.js); this is for
# every other one. Origins are exact - scheme, host and port all have to match, and
# there is no trailing slash.
#
#   the deployed game          https://your-app.vercel.app
#   a Vercel preview build     https://your-app-git-branch-you.vercel.app
#   your phone over Wi-Fi      http://192.168.1.5:5173
#
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://192.168.1.5:5173
